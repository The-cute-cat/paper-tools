# DeepSeek API 配置（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选配置（不填则用默认值）
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 输出根目录（默认 ./output）
# PAPER_TOOLS_OUTPUT=./output

# 日志级别：DEBUG / INFO / WARNING / ERROR
# PAPER_TOOLS_LOG_LEVEL=INFO

# 并发翻译线程数（0/1 表示单线程）
# PAPER_TOOLS_CONCURRENCY=8

# 图片本地模式：1/true = 下载图片到本地并改用本地相对路径；否则保持原网络 URL（不下载）
# PAPER_TOOLS_IMG_LOCAL=false

# 图片等二进制下载失败时的重试次数
# PAPER_TOOLS_DL_RETRIES=3

# 翻译单元目标长度下限（纯文本字符数）：相邻同类文本块贪心凑成
# [MERGE_MIN, MERGE_MAX] 区间的单元一起翻译；0 关闭合并
# PAPER_TOOLS_MERGE_MIN=1000

# 翻译单元目标长度上限（纯文本字符数）：累计达该值即关闭当前单元；0 不限制
# PAPER_TOOLS_MERGE_MAX=1500

# 引用文献的搜索引擎（默认 bing，国内可访问）
# 可选：google | bing | duckduckgo | semantic_scholar | arxiv
# PAPER_TOOLS_CITE_SEARCH=bing

# 引用显示模式：short = 作者年份短链（论文名靠 hover 提示）
#              title = 作者年份 + 完整论文名（占行宽，但信息完整）
# PAPER_TOOLS_CITE_DISPLAY=short

# 输出文件命名方式：id       = 用 arxiv ID 命名（默认，如 2603.16192v1.zh.md）
#                  title    = 用原论文英文标题命名（非法符号自动换为等价中文符号）
#                  title_zh = 用翻译后的中文标题命名（非法符号自动换为等价中文符号）
# PAPER_TOOLS_NAME_MODE=id

# Token 用量报告：1/true = 翻译结束后在日志输出总 token 消耗、缓存命中/未命中及占比
# 默认关闭，避免控制台刷屏
# PAPER_TOOLS_TOKEN_REPORT=false

# 额外导出格式：翻译完成后自动导出 DOCX / PDF。
# 支持逗号分隔，如 docx,pdf 或 docx 或 pdf 或 all（等同于 docx,pdf）。
# 默认留空，只输出 .zh.md。
# PAPER_TOOLS_EXPORT_FORMATS=docx,pdf

# 是否仍输出 .zh.md：1/true = 导出 docx/pdf 时保留 markdown；0/false = 只产出 docx/pdf。
# 默认 true。
# PAPER_TOOLS_OUTPUT_MD=true

# 跳过翻译：1/true = 不调用 LLM，仅解析并输出论文英文原文（结构化原文 markdown）。
# 开启后无需配置 DEEPSEEK_API_KEY。默认 false。
# PAPER_TOOLS_SKIP_TRANSLATE=false

# 待翻译的 arxiv 链接或 ID，例如 "https://arxiv.org/abs/2605.26158v1" 或 "2605.26158v1"。
# 留空时回退到 main.py 的 INPUT 常量。
# PAPER_TOOLS_INPUT=

# 下载代理（标准 CONNECT 隧道，支持图片等二进制下载），如 http://127.0.0.1:7890
# 留空表示直连；也兼容 HTTP_PROXY / HTTPS_PROXY 环境变量
# PAPER_TOOLS_PROXY=

# 轻量 CORS 文本转发代理（仅文本/HTML 下载，不支持二进制），如 https://your-worker.dev/?url=
# 留空表示文本下载也走 PAPER_TOOLS_PROXY / 直连
# PAPER_TOOLS_CORS_PROXY=

# 断点续译模式：ask = 终端询问恢复/重翻/退出（默认）；auto = 自动恢复；never = 从头重翻
# PAPER_TOOLS_RESUME_MODE=ask

# 立场摘要截断上限（字符）：0 = 不截断，使用完整论文摘要
# PAPER_TOOLS_SUMMARY_MAX_CHARS=0
# PDF 逐页提取（与翻译共用 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL）
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
PAPER_TOOLS_PDF_DPI=160

